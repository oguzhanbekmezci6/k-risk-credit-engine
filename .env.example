# K-RİSK V14 — örnek yerel yapılandırma
# Bu uygulama gerçek değildir ve mezuniyet sonrası öğrenme amaçlı projedir.
KRISK_MODE=production
KRISK_DB_PATH=/secure-data/k_risk.db
KRISK_HOST=127.0.0.1
KRISK_PORT=8765
KRISK_COOKIE_SECURE=true
KRISK_DOCS_ENABLED=false
KRISK_SESSION_IDLE=1800
KRISK_SESSION_ABSOLUTE=28800
KRISK_MAX_JSON_BYTES=2097152
KRISK_LOGIN_RATE_LIMIT=8
KRISK_LOGIN_RATE_WINDOW=300
KRISK_GLOBAL_RATE_LIMIT=300
KRISK_GLOBAL_RATE_WINDOW=60
KRISK_ACCOUNT_LOCK_THRESHOLD=5
KRISK_ACCOUNT_LOCK_SECONDS=900
KRISK_ALLOWED_ORIGINS=
KRISK_TRUSTED_HOSTS=127.0.0.1,localhost
